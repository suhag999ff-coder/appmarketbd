rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Users
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role','isAdmin','admin','suspended','disabled']);
      allow delete: if isAdmin();
    }

    // Admins — read self, write only via Cloud Function (admin SDK bypasses rules)
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if false; // Cloud Function handles this
    }

    // Products
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /private/{docId} {
        allow read: if isAdmin(); // Only admin reads directly; users get URLs via Cloud Function
        allow write: if isAdmin();
      }
    }

    // Categories
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Settings — public doc readable by all, secrets only admin
    match /settings/{docId} {
      allow read: if docId == 'public' || isAdmin();
      allow write: if isAdmin();
    }

    // Audit logs
    match /auditLogs/{id} {
      allow read, write: if isAdmin();
    }
  }
}
